# ===== Hermes AIH -> Bitrix24 =====
# Copie para ".env" (NUNCA versionar) e preencha SOMENTE a linha BITRIX_WEBHOOK_URL. As demais ja vem com valores usuais.
# Todas as variaveis tambem podem vir do ambiente (o ambiente vence o arquivo).

# Webhook de ENTRADA do Bitrix24 (SEGREDO). Recomendado: webhook dedicado, so com escopos
# crm, im, imopenlines, disk (revogue o webhook de permissao total depois).
BITRIX_WEBHOOK_URL=https://brandaocorrea.bitrix24.com.br/rest/<ID>/<TOKEN>/

# Poller dos Canais Abertos: IDs de dialogo separados por virgula (chat360293 = grupo "Docs protocolo").
OL_DIALOG_IDS=chat360293
# POLL_INTERVAL_SEC=30

# Banco SQLite de idempotencia (hash dos arquivos + cursor do poller). Relativo a pasta do app.
LEDGER_PATH=data/ledger.sqlite3

# So para o modo servidor (`serve`): chave exigida no header X-API-Key do POST /upload. Use um segredo longo e
# aleatorio, por exemplo:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# Sem ela o app funciona normalmente pela CLI e pelo poller; so POST /upload e /poll respondem 503.
# HERMES_API_KEY=
# Somente para uso local/desenvolvimento: permite chamar a API sem chave.
# ALLOW_NO_AUTH=false

# SPA "Leads Auxilio Acidente". Se vazios, o app descobre a categoria padrao e a etapa inicial.
# BITRIX_SPA_ENTITY_TYPE_ID=1146
# BITRIX_SPA_CATEGORY_ID=101
# BITRIX_SPA_STAGE_ID=DT1146_101:NEW

# O portal reescreve titulo/etapa/responsavel do card (automacao da casa). Template do titulo inicial:
# CARD_TITLE_TEMPLATE={nome} ➡ AIH {cid} ➡ {data_solicitacao}

# Outros
# MAX_PDF_MB=15
# VERIFY_DELAY_SEC=8
# LOG_LEVEL=INFO
